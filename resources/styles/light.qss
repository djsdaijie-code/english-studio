QWidget {
    background: #f5f7fa;
    color: #111827;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 14px;
}

QLabel {
    background: transparent;
}

QMainWindow, QWidget#RootShell {
    background: #f5f7fa;
}

QFrame#Sidebar {
    background: #fbfcfe;
    border-right: 1px solid #e5e7eb;
}

QFrame#ContentArea {
    background: transparent;
}

QFrame#TodayLearningTimeBar {
    min-height: 34px;
    max-height: 34px;
    background: #fbfcfe;
    border-bottom: 1px solid #e5eaf1;
}

QLabel#TodayLearningTimeTitle {
    color: #64748b;
    font-size: 12px;
}

QLabel#TodayLearningTimeValue {
    color: #20324a;
    font-size: 13px;
    font-weight: 650;
}

QToolButton#TodayLearningTimeToggle {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 4px;
}

QToolButton#TodayLearningTimeToggle:hover {
    background: #edf2f8;
}

QFrame#Card, QFrame#MetricCard, QFrame#EmptyCard, QFrame#PanelCard {
    background: #ffffff;
    border: 1px solid #ebeff5;
    border-radius: 12px;
}

QFrame#CardAccent {
    background: #edf4ff;
    border: 1px solid #dbeafe;
    border-radius: 12px;
}

QScrollArea#HomeScroll, QWidget#HomeContent {
    background: transparent;
    border: none;
}

QFrame#HomeContinueCard, QFrame#HomeGoalCard, QFrame#HomePanel {
    background: #ffffff;
    border: 1px solid #e7ecf3;
    border-radius: 14px;
}

QFrame#HomeCourseCover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2867ec, stop:0.58 #5b7cf2, stop:1 #a68cf2);
    border: none;
    border-radius: 12px;
}

QLabel[role="home-cover-title"] {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
}

QLabel[role="home-cover-meta"] {
    color: #edf4ff;
    font-size: 13px;
}

QLabel[role="home-kicker"] {
    color: #2563eb;
    background: #edf4ff;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 12px;
}

QLabel[role="home-course-title"] {
    color: #0f172a;
    font-size: 21px;
    font-weight: 700;
}

QLabel[role="home-lesson-title"], QLabel[role="home-section-title"] {
    color: #111827;
    font-size: 17px;
    font-weight: 650;
}

QLabel[role="home-meta"] {
    color: #69778c;
    font-size: 12px;
}

QLabel[role="home-goal-value"], QLabel[role="home-task-title"], QLabel[role="home-goal-footer"] {
    color: #172033;
    font-weight: 600;
}

QLabel[role="home-task-status"] {
    color: #78869a;
    font-size: 12px;
}

QLabel[role="home-task-status"][completed="true"] {
    color: #2f9b57;
}

QFrame#HomeTaskRow, QFrame#HomeRecentRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid #edf0f5;
}

QLabel#HomeTaskBadge {
    border-radius: 8px;
    font-weight: 700;
}

QLabel#HomeTaskBadge[tone="blue"] { background: #e9f1ff; color: #2563eb; }
QLabel#HomeTaskBadge[tone="green"] { background: #ebf8ef; color: #2f9b57; }
QLabel#HomeTaskBadge[tone="violet"] { background: #f2edff; color: #7c4fe0; }
QLabel#HomeTaskBadge[tone="cyan"] { background: #e8f8fa; color: #168b9b; }
QLabel#HomeTaskBadge[tone="amber"] { background: #fff5e5; color: #d48118; }

QFrame#HomeQuickCard {
    background: #f7f9fc;
    border: 1px solid #e8edf4;
    border-radius: 10px;
}

QLabel[role="home-quick-title"] {
    color: #1e293b;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[variant="home-outline"] {
    min-height: 30px;
    padding: 0 11px;
    color: #2563eb;
    border: 1px solid #bcd0f6;
    background: transparent;
}

QPushButton[variant="home-quick"] {
    min-height: 28px;
    padding: 0 8px;
    color: #2563eb;
    border: 1px solid #d4e0f5;
    background: #ffffff;
}

QProgressBar#HomeCourseProgress, QProgressBar#HomeRecentProgress {
    background: #e6ebf3;
    border: none;
    border-radius: 3px;
}

QProgressBar#HomeCourseProgress::chunk, QProgressBar#HomeRecentProgress::chunk {
    background: #2f6fec;
    border-radius: 3px;
}

QLabel[role="page-title"] {
    font-size: 24px;
    font-weight: 600;
    color: #0f172a;
}

QLabel[role="app-title"] {
    font-size: 22px;
    font-weight: 600;
    color: #0f172a;
}

QLabel[role="subtitle"], QLabel[role="muted"] {
    color: #6b7280;
}

QLabel[role="course-page-subtitle"] {
    color: #7b8494;
    font-size: 13px;
}

QListWidget#CourseList {
    padding: 6px;
    background: transparent;
    border: none;
}

QListWidget#CourseList::item {
    background: transparent;
    border: none;
}

QFrame#CourseListCard {
    background: #ffffff;
    border: 1px solid #e5eaf1;
    border-radius: 12px;
}

QFrame#CourseListCard[selected="true"] {
    background: #f4f8ff;
    border-color: #b9cdf1;
}

QFrame#CourseListSelectionBar {
    background: transparent;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QFrame#CourseListCard[selected="true"] QFrame#CourseListSelectionBar {
    background: #4b78b8;
}

QPushButton#CourseBackButton {
    min-height: 40px;
    padding: 0 16px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-weight: 600;
}

QPushButton#CourseBackButton:hover {
    background: #edf4ff;
    border-color: #8eb0df;
    color: #245caa;
}

QPushButton#CourseBackButton:pressed {
    background: #dfeafb;
}

QFrame#CourseProgressCard {
    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 12px;
}

QLabel[role="course-progress-title"] {
    color: #334155;
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="course-progress-value"] {
    color: #245fbe;
    font-size: 18px;
    font-weight: 700;
}

QLabel[role="course-progress-detail"], QLabel[role="course-progress-status"] {
    color: #64748b;
    font-size: 13px;
}

QProgressBar#CourseOverallProgress {
    min-height: 10px;
    max-height: 10px;
    background: #e7edf5;
    border: none;
    border-radius: 5px;
}

QProgressBar#CourseOverallProgress::chunk {
    background: #3974d8;
    border-radius: 5px;
}

QTreeWidget#CourseHierarchy {
    background: transparent;
    border: none;
    border-radius: 0;
    outline: none;
}

QTreeWidget#CourseHierarchy::item {
    background: transparent;
    border: none;
    padding: 3px 0;
}

QTreeWidget#CourseHierarchy::item:selected {
    background: #eaf2ff;
    color: #111827;
}

QFrame#CourseStructureRow {
    border: none;
    border-radius: 10px;
}

QFrame#CourseStructureRow[kind="level"] {
    background: #eef4fc;
    border: 1px solid #d7e3f2;
}

QFrame#CourseStructureRow[kind="unit"] {
    background: #ffffff;
    border: 1px solid #e3e8ef;
}

QFrame#CourseStructureRow[kind="lesson"] {
    background: #fbfcfe;
    border: 1px solid #edf0f4;
}

QLabel[role="course-structure-level-title"] {
    color: #172033;
    font-size: 16px;
    font-weight: 700;
}

QLabel[role="course-structure-unit-title"] {
    color: #243149;
    font-size: 15px;
    font-weight: 600;
}

QLabel[role="course-structure-lesson-title"] {
    color: #334155;
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="course-structure-metadata"], QLabel[role="course-structure-status"] {
    color: #718096;
    font-size: 12px;
}

QLabel[role="course-structure-percentage"] {
    color: #3970be;
    font-size: 12px;
    font-weight: 600;
}

QProgressBar#CourseStructureProgress {
    min-height: 7px;
    max-height: 7px;
    background: #e3e9f1;
    border: none;
    border-radius: 3px;
}

QProgressBar#CourseStructureProgress::chunk {
    background: #4d7fd1;
    border-radius: 3px;
}

QLabel[role="course-card-title"] {
    color: #111827;
    font-size: 18px;
    font-weight: 600;
}

QLabel[role="course-card-description"] {
    color: #64748b;
    font-size: 14px;
    font-weight: 400;
}

QLabel[role="course-card-statistics"] {
    color: #94a3b8;
    font-size: 12px;
}

QLabel[role="metric-title"] {
    color: #6b7280;
    font-size: 13px;
}

QLabel[role="metric-value"] {
    color: #111827;
    font-size: 28px;
    font-weight: 600;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #dbe1ea;
    border-radius: 10px;
    min-height: 38px;
    padding: 0 14px;
}

QPushButton:hover {
    background: #f8fafc;
}

QPushButton:pressed {
    background: #eef2f7;
}

QPushButton[variant="primary"] {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
}

QPushButton[variant="primary"]:hover {
    background: #1d4ed8;
}

QPushButton[variant="danger"] {
    color: #b42318;
    border: 1px solid #f0c7c2;
    background: #fff7f6;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: #475467;
}

QPushButton[nav="true"] {
    text-align: left;
    padding-left: 14px;
    border: 1px solid transparent;
    background: transparent;
    color: #4b5563;
}

QPushButton[nav="true"][active="true"] {
    background: #eaf1ff;
    color: #1d4ed8;
    border: 1px solid #dbeafe;
    font-weight: 600;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit, QTextBrowser, QDateEdit, QListWidget, QTableWidget {
    background: #ffffff;
    border: 1px solid #dbe1ea;
    border-radius: 10px;
    selection-background-color: #dbeafe;
    selection-color: #111827;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    min-height: 38px;
    padding: 0 10px;
}

QTextEdit, QPlainTextEdit, QTextBrowser {
    padding: 10px;
}

QHeaderView::section {
    background: #f8fafc;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    padding: 8px;
    color: #475467;
}

QTableWidget {
    gridline-color: #eef2f7;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #d0d7e2;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QFrame#PracticeSourceCard, QFrame#PracticeInputCard {
    background: #ffffff;
    border: 1px solid #dbe1ea;
    border-radius: 12px;
}

QTextBrowser#PracticeSource {
    border: none;
    background: #fbfcfe;
}

QPlainTextEdit#PracticeInput {
    background: #ffffff;
    border: 2px solid #aebdd0;
    border-radius: 10px;
    padding: 16px;
    line-height: 1.6;
}

QPlainTextEdit#PracticeInput:focus {
    border: 2px solid #5f7898;
    background: #fbfdff;
}

QLabel[role="section-title"] {
    color: #0f172a;
    font-size: 16px;
    font-weight: 600;
}

QSplitter::handle:vertical {
    background: transparent;
    height: 8px;
}

QFrame#TranslationCard {
    background: #ffffff;
    border: 1px solid #dbe1ea;
    border-radius: 12px;
}

QLabel#SentenceTranslationHeading {
    color: #0f172a;
    font-size: 19px;
    font-weight: 700;
}

QLabel#SentenceTranslationStatus {
    color: #506987;
    font-size: 12px;
    background: #eef4fa;
    border: 1px solid #d9e5f1;
    border-radius: 9px;
    padding: 4px 9px;
}

QFrame#SentenceTranslationBody {
    background: #f5f8fc;
    border: 1px solid #dce6f0;
    border-radius: 10px;
}

QLabel#SentenceTranslationText {
    color: #142033;
    font-size: 20px;
    font-weight: 600;
}

QLabel#SentenceSourceTitle {
    color: #8491a3;
    font-size: 12px;
    font-weight: 600;
}

QLabel#SentenceTranslationSource {
    color: #64748b;
    font-size: 14px;
}

QLabel#SentenceExpressionsTitle {
    color: #25364d;
    font-size: 15px;
    font-weight: 600;
}

QLabel#SentenceExpressionsText {
    color: #526176;
    font-size: 14px;
}

QFrame#ContinuousTranslationCard {
    background: #ffffff;
    border: 1px solid #dbe1ea;
    border-radius: 12px;
}

QToolButton#TranslationVisibilityButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QToolButton#TranslationVisibilityButton:hover {
    background: #f1f5f9;
}

QToolButton#SpeechButton { background: transparent; border: none; border-radius: 8px; padding: 6px; }
QToolButton#SpeechButton:hover { background: #f1f5f9; }

QLabel#ContinuousTranslationText {
    color: #334155;
    font-size: 17px;
}

QLabel#ContinuousTranslationText[hidden="true"] {
    color: #94a3b8;
}

QFrame#SegmentedControl {
    background: #eef2f7;
    border: 1px solid #dbe1ea;
    border-radius: 11px;
}

QPushButton[segment="true"] {
    min-height: 34px;
    padding: 0 16px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #64748b;
}

QPushButton[segment="true"]:checked {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #172033;
    font-weight: 600;
}

QFrame#VocabularyQuickAccess {
    background: transparent;
    border: none;
}

QToolButton#VocabularyQuickButton {
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
    background: #ffffff;
    border: 1px solid #cbd8e8;
    border-radius: 24px;
}

QToolButton#VocabularyQuickButton:hover {
    background: #edf4ff;
    border-color: #82a6d4;
}

QFrame#VocabularyAddedPopup {
    min-width: 286px;
    max-width: 340px;
    background: #ffffff;
    border: 1px solid #d5e0ec;
    border-radius: 12px;
}

QLabel[role="vocabulary-popup-title"] {
    color: #52647a;
    font-size: 12px;
    font-weight: 600;
}

QLabel[role="vocabulary-popup-word"] {
    color: #172033;
    font-size: 20px;
    font-weight: 700;
}

QLabel[role="vocabulary-popup-message"] {
    color: #6b7d93;
    font-size: 12px;
}
