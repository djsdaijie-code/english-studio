QWidget {
    background: #0f1720;
    color: #e5edf7;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 14px;
}

QLabel {
    background: transparent;
}

QMainWindow, QWidget#RootShell {
    background: #0f1720;
}

QFrame#Sidebar {
    background: #111b28;
    border-right: 1px solid #223043;
}

QFrame#ContentArea {
    background: transparent;
}

QFrame#Card, QFrame#MetricCard, QFrame#EmptyCard, QFrame#PanelCard {
    background: #152232;
    border: 1px solid #223043;
    border-radius: 12px;
}

QFrame#CardAccent {
    background: #162843;
    border: 1px solid #264a80;
    border-radius: 12px;
}

QLabel[role="page-title"], QLabel[role="app-title"] {
    color: #f8fbff;
    font-weight: 600;
}

QLabel[role="page-title"] {
    font-size: 24px;
}

QLabel[role="app-title"] {
    font-size: 30px;
}

QLabel[role="subtitle"], QLabel[role="muted"], QLabel[role="metric-title"] {
    color: #96a5b8;
}

QLabel[role="course-page-subtitle"] {
    color: #8393a8;
    font-size: 13px;
}

QListWidget#CourseList {
    padding: 6px;
    background: transparent;
    border: none;
}

QListWidget#CourseList::item {
    background: transparent;
    border: none;
}

QFrame#CourseListCard {
    background: #152232;
    border: 1px solid #26384f;
    border-radius: 12px;
}

QFrame#CourseListCard[selected="true"] {
    background: #182b43;
    border-color: #3b6090;
}

QFrame#CourseListSelectionBar {
    background: transparent;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QFrame#CourseListCard[selected="true"] QFrame#CourseListSelectionBar {
    background: #6f9ed8;
}

QLabel[role="course-card-title"] {
    color: #f5f8fc;
    font-size: 18px;
    font-weight: 600;
}

QLabel[role="course-card-description"] {
    color: #a8b6c8;
    font-size: 14px;
    font-weight: 400;
}

QLabel[role="course-card-statistics"] {
    color: #7f91a7;
    font-size: 12px;
}

QLabel[role="metric-value"] {
    color: #f8fbff;
    font-size: 28px;
    font-weight: 600;
}

QPushButton {
    background: #172636;
    border: 1px solid #26384f;
    border-radius: 10px;
    min-height: 38px;
    padding: 0 14px;
    color: #e5edf7;
}

QPushButton:hover {
    background: #1c3045;
}

QPushButton[variant="primary"] {
    background: #3b82f6;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

QPushButton[variant="primary"]:hover {
    background: #2563eb;
}

QPushButton[variant="danger"] {
    color: #ffb4ab;
    border: 1px solid #6f2d2b;
    background: #311918;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: #9fb0c5;
}

QPushButton[nav="true"] {
    text-align: left;
    padding-left: 14px;
    border: 1px solid transparent;
    background: transparent;
    color: #9fb0c5;
}

QPushButton[nav="true"][active="true"] {
    background: #172b48;
    color: #8fb8ff;
    border: 1px solid #244676;
    font-weight: 600;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit, QTextBrowser, QDateEdit, QListWidget, QTableWidget {
    background: #111b28;
    border: 1px solid #26384f;
    border-radius: 10px;
    selection-background-color: #21457c;
    selection-color: #f8fbff;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    min-height: 38px;
    padding: 0 10px;
}

QTextEdit, QPlainTextEdit, QTextBrowser {
    padding: 10px;
}

QHeaderView::section {
    background: #132031;
    border: none;
    border-bottom: 1px solid #223043;
    padding: 8px;
    color: #a9bad0;
}

QTableWidget {
    gridline-color: #1f2b3c;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: #39506d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}

QFrame#PracticeSourceCard, QFrame#PracticeInputCard {
    background: #152232;
    border: 1px solid #2d4058;
    border-radius: 12px;
}

QTextBrowser#PracticeSource {
    border: none;
    background: #111b28;
}

QPlainTextEdit#PracticeInput {
    background: #101a27;
    border: 2px solid #405874;
    border-radius: 10px;
    padding: 16px;
    color: #f1f5f9;
    line-height: 1.6;
}

QPlainTextEdit#PracticeInput:focus {
    border: 2px solid #7797bb;
    background: #132131;
}

QLabel[role="section-title"] {
    color: #f8fbff;
    font-size: 16px;
    font-weight: 600;
}

QSplitter::handle:vertical {
    background: transparent;
    height: 8px;
}

QFrame#TranslationCard {
    background: #152232;
    border: 1px solid #2d4058;
    border-radius: 12px;
}

QLabel#SentenceTranslationHeading {
    color: #f4f8fc;
    font-size: 19px;
    font-weight: 700;
}

QLabel#SentenceTranslationStatus {
    color: #b8c8dc;
    font-size: 12px;
    background: #203247;
    border: 1px solid #344b65;
    border-radius: 9px;
    padding: 4px 9px;
}

QFrame#SentenceTranslationBody {
    background: #192a3d;
    border: 1px solid #334a64;
    border-radius: 10px;
}

QLabel#SentenceTranslationText {
    color: #f3f7fc;
    font-size: 20px;
    font-weight: 600;
}

QLabel#SentenceSourceTitle {
    color: #8091a7;
    font-size: 12px;
    font-weight: 600;
}

QLabel#SentenceTranslationSource {
    color: #a9b7c9;
    font-size: 14px;
}

QLabel#SentenceExpressionsTitle {
    color: #dce6f2;
    font-size: 15px;
    font-weight: 600;
}

QLabel#SentenceExpressionsText {
    color: #adbacb;
    font-size: 14px;
}

QFrame#ContinuousTranslationCard {
    background: #152232;
    border: 1px solid #2d4058;
    border-radius: 12px;
}

QToolButton#TranslationVisibilityButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QToolButton#TranslationVisibilityButton:hover {
    background: #1d2d40;
}

QToolButton#SpeechButton { background: transparent; border: none; border-radius: 8px; padding: 6px; }
QToolButton#SpeechButton:hover { background: #1d2d40; }

QLabel#ContinuousTranslationText {
    color: #d5deea;
    font-size: 17px;
}

QLabel#ContinuousTranslationText[hidden="true"] {
    color: #8291a5;
}

QFrame#SegmentedControl {
    background: #101a27;
    border: 1px solid #2d4058;
    border-radius: 11px;
}

QPushButton[segment="true"] {
    min-height: 34px;
    padding: 0 16px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #91a2b8;
}

QPushButton[segment="true"]:checked {
    background: #24364b;
    border-color: #405874;
    color: #f4f7fb;
    font-weight: 600;
}
